{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Deliberately lenient to start. This codebase has zero type
       annotations today — turning on strict mode immediately would surface
       hundreds of pre-existing "implicit any" warnings and bury the small
       number of genuinely useful ones. Start lenient, tighten over time as
       JSDoc annotations get added to the functions that matter most
       (the ones most often touched or most bug-prone, e.g. anything in
       state-core.js or rendering-engine.js). */
    "strict": false,
    "noImplicitAny": false,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/js/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
